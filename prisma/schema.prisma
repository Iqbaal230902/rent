// Skema database Pleazure Bike Rent (PRD bagian 6).
// Semua waktu disimpan dalam UTC; ditampilkan dalam WIB (Asia/Jakarta).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum BikeCategory {
  ROAD
  MTB
  EBIKE
  FOLDING
}

enum UnitStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  IN_USE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum PaymentGateway {
  MANUAL
  MIDTRANS
  XENDIT
  TRIPAY
}

enum PaymentMethod {
  TUNAI
  TRANSFER
  QRIS_STATIS
  QRIS_DINAMIS
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum CollateralType {
  KTP
  SIM
  LAINNYA
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(190)
  phone        String?  @db.VarChar(30)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bookings          Booking[]
  confirmedPayments Payment[]  @relation("PaymentConfirmedBy")
  checkIns          Rental[]   @relation("RentalCheckedInBy")
  checkOuts         Rental[]   @relation("RentalCheckedOutBy")
  auditLogs         AuditLog[]

  @@map("users")
}

model BikeModel {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(120)
  slug         String       @unique @db.VarChar(140)
  category     BikeCategory
  description  String?      @db.Text
  specs        Json // { "Frame": "Alloy", "Ukuran": "M", ... }
  photos       Json // ["https://..."]
  frameSize    String?      @map("frame_size") @db.VarChar(40)
  pricePerHour Int          @map("price_per_hour")
  pricePerDay  Int          @map("price_per_day")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  units    BikeUnit[]
  bookings Booking[]

  @@map("bike_models")
}

model BikeUnit {
  id           Int        @id @default(autoincrement())
  modelId      Int        @map("model_id")
  serialNumber String     @unique @map("serial_number") @db.VarChar(80)
  status       UnitStatus @default(AVAILABLE)
  notes        String?    @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  model        BikeModel     @relation(fields: [modelId], references: [id])
  bookingUnits BookingUnit[]

  @@index([modelId, status])
  @@map("bike_units")
}

model Booking {
  id            Int           @id @default(autoincrement())
  code          String        @unique @db.VarChar(20)
  publicToken   String        @unique @map("public_token") @db.VarChar(64)
  userId        Int?          @map("user_id")
  customerName  String        @map("customer_name") @db.VarChar(120)
  customerPhone String        @map("customer_phone") @db.VarChar(30)
  customerEmail String        @map("customer_email") @db.VarChar(190)
  modelId       Int           @map("model_id")
  quantity      Int
  startAt       DateTime      @map("start_at")
  endAt         DateTime      @map("end_at")
  status        BookingStatus @default(PENDING_PAYMENT)
  holdExpiresAt DateTime?     @map("hold_expires_at")
  subtotal      Int
  totalAmount   Int           @map("total_amount")
  notes         String?       @db.VarChar(255)
  paidAt        DateTime?     @map("paid_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  expiredAt     DateTime?     @map("expired_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User?         @relation(fields: [userId], references: [id])
  model    BikeModel     @relation(fields: [modelId], references: [id])
  units    BookingUnit[]
  payments Payment[]
  invoice  Invoice?
  rental   Rental?

  @@index([status, holdExpiresAt])
  @@index([modelId, status, startAt, endAt])
  @@index([startAt])
  @@map("bookings")
}

/// Slot unit yang dikunci. unit_id diisi saat check-in (alokasi unit fisik).
model BookingUnit {
  id        Int      @id @default(autoincrement())
  bookingId Int      @map("booking_id")
  unitId    Int?     @map("unit_id")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")

  booking Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  unit    BikeUnit? @relation(fields: [unitId], references: [id])

  @@index([unitId, startAt, endAt])
  @@index([bookingId])
  @@map("booking_units")
}

model Payment {
  id             Int            @id @default(autoincrement())
  bookingId      Int            @map("booking_id")
  gateway        PaymentGateway @default(MANUAL)
  method         PaymentMethod?
  gatewayOrderId String         @unique @map("gateway_order_id") @db.VarChar(80)
  qrString       String?        @map("qr_string") @db.Text
  amount         Int
  status         PaymentStatus  @default(PENDING)
  paidAt         DateTime?      @map("paid_at")
  confirmedById  Int?           @map("confirmed_by")
  note           String?        @db.VarChar(255)
  rawPayload     Json?          @map("raw_payload")
  createdAt      DateTime       @default(now()) @map("created_at")

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  confirmedBy User?   @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])

  @@index([bookingId])
  @@map("payments")
}

/// Kunci idempotensi webhook payment gateway (dipakai mulai Fase 2).
model WebhookEvent {
  id          Int       @id @default(autoincrement())
  gateway     PaymentGateway
  eventId     String    @unique @map("event_id") @db.VarChar(120)
  payload     Json
  processedAt DateTime? @map("processed_at")
  result      String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("webhook_events")
}

model Invoice {
  id            Int      @id @default(autoincrement())
  bookingId     Int      @unique @map("booking_id")
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(40)
  pdfUrl        String?  @map("pdf_url") @db.VarChar(255)
  issuedAt      DateTime @default(now()) @map("issued_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Rental {
  id               Int             @id @default(autoincrement())
  bookingId        Int             @unique @map("booking_id")
  checkedInById    Int             @map("checked_in_by")
  checkedInAt      DateTime        @map("checked_in_at")
  collateralType   CollateralType  @map("collateral_type")
  collateralNote   String?         @map("collateral_note") @db.VarChar(255)
  checkedOutById   Int?            @map("checked_out_by")
  checkedOutAt     DateTime?       @map("checked_out_at")
  lateMinutes      Int             @default(0) @map("late_minutes")
  lateFee          Int             @default(0) @map("late_fee")
  damageFee        Int             @default(0) @map("damage_fee")
  damageNote       String?         @map("damage_note") @db.VarChar(255)
  settlementMethod PaymentMethod?  @map("settlement_method")
  collateralReturned Boolean       @default(false) @map("collateral_returned")

  booking      Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkedInBy  User    @relation("RentalCheckedInBy", fields: [checkedInById], references: [id])
  checkedOutBy User?   @relation("RentalCheckedOutBy", fields: [checkedOutById], references: [id])

  @@map("rentals")
}

model Setting {
  key   String @id @db.VarChar(80)
  value String @db.Text

  @@map("settings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?     @map("actor_id")
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(60)
  entityId  String?  @map("entity_id") @db.VarChar(60)
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}
